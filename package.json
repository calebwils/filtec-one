{
  "name": "filtec-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --env-file=.env --experimental-strip-types --test 'src/utils/__tests__/*.test.ts' 'src/lib/__tests__/*.test.ts'",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "prisma studio -p 5555",
    "deploy": "bash scripts/deploy-live.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.45.0",
    "next": "^16.4.3",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
