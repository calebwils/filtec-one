# Database Connection (PostgreSQL with Supabase / Neon / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/filtec_db?schema=public"

# Production Authentication Secret (Required in production, minimum 32 characters / 256 bits)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-high-entropy-auth-secret-here-minimum-32-characters"
